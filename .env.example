# Development Environment Configuration
# Copy this file to .env and update with your local values

DEBUG=True
SECRET_KEY=django-insecure-dev-only-change-in-production

# Server Configuration
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# OpenAI API
OPENAI_API_KEY=sk-your-openai-key-here

# Email (Optional for development)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
# Optional: defaults are Gmail. For a provider on port 465 (implicit TLS),
# set EMAIL_PORT=465, EMAIL_USE_TLS=False, EMAIL_USE_SSL=True.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Payments — one-time Pro purchases through Paddle (merchant of record).
# Setup: .claude/integrations/payments.md. coming_soon = plans shown, no
# checkout; test = checkout for staff accounts only (sandbox test on the live
# site); live = checkout for everyone. test/live also need the token + secret.
PAYMENT_STATUS=coming_soon
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_3M=
PADDLE_PRICE_PRO_12M=
# Where people reach a human (legal pages, refunds).
CONTACT_EMAIL=privacy@resustackapp.com

# MCP Registry — the domain proof served at /.well-known/mcp-registry-auth.
# Public key record only, e.g. "v=MCPv1; k=ed25519; p=<base64>". See README.
MCP_REGISTRY_AUTH=

# Google sign-in (optional). The button stays hidden until both are set.
# Redirect URI to register: http://localhost:8000/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Error tracking (optional). EU data region. See .claude/integrations/sentry.md.
SENTRY_DSN=
SENTRY_BROWSER_DSN=
# SENTRY_ENVIRONMENT=production

# Product analytics (optional). EU Cloud. See .claude/integrations/posthog.md.
POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
