# Development Environment Configuration
# Copy this file to .env and update with your local values

DEBUG=True
SECRET_KEY=django-insecure-dev-only-change-in-production

# Server Configuration
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# OpenAI API
OPENAI_API_KEY=sk-your-openai-key-here

# Email (Optional for development)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Payments — one-time Pro purchases. See .claude/PAYMENTS.md for setup.
# Leave CHECKOUT_URL_* empty and the pricing page shows "not set up yet"
# rather than sending anyone to a half-configured checkout.
# coming_soon: plans are shown, nothing takes money. Flip to "live" once a
# provider is configured.
PAYMENT_STATUS=coming_soon
PAYMENT_PROVIDER=lemonsqueezy
PAYMENT_WEBHOOK_SECRET=
CHECKOUT_URL_PRO_3M=
CHECKOUT_URL_PRO_12M=
PRODUCT_ID_PRO_3M=
PRODUCT_ID_PRO_12M=
